# --- Rác tạm của các lần chạy QA -------------------------------------------
# File tạm đều có tiền tố "_" (tools/_gate-*, tools/_dk-*, tools/_lp-*, ...)
tools/_*
tools/_*/

# DOM dump của audit / flows / web-check — sinh lại bằng tools/verify-all.ps1
tools/dom-*.html
tools/qa-dom-*.html
tools/*.err

# --- Hệ điều hành -----------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Trình soạn thảo / công cụ ---------------------------------------------
.vscode/
.idea/
*.log
node_modules/
__pycache__/
*.pyc
